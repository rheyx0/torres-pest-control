# Torres Pest Control — settings for running the system on this computer.
# Copy this file to .env.local (copy .env.local.example .env.local), then fill
# in the two passwords below. .env.local is never committed.

# Where the app finds its API: the local gateway started by `npm run local`.
REACT_APP_SUPABASE_URL=http://localhost:54321
REACT_APP_SUPABASE_PUBLISHABLE_KEY=local

# The password you gave the "postgres" user when you installed PostgreSQL.
LOCAL_DB_PASSWORD=

# A password for the system's first account (username: admin), at least 6 characters.
LOCAL_ADMIN_PASSWORD=

# Where you unzipped PostgREST.
POSTGREST_PATH=C:\postgrest\postgrest.exe
